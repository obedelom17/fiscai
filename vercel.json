{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cron/quotidien", "schedule": "0 7 * * *" },
    { "path": "/api/cron/sauvegarde", "schedule": "0 2 * * 0" }
  ]
}
